{
  "name": "@krizaka/config",
  "version": "0.1.0",
  "description": "The shared configuration of every Krizaka JavaScript repository: ESLint flat configs (base, Next.js, the four UI rules, no locale ternary), tsconfig bases, Prettier, EditorConfig, and the krizaka-ratchet debt counter.",
  "keywords": [
    "krizaka",
    "eslint-config",
    "tsconfig",
    "prettier-config",
    "ratchet",
    "design-system"
  ],
  "homepage": "https://github.com/krizaka/krizaka-ui/tree/main/packages/config#readme",
  "bugs": "https://github.com/krizaka/krizaka-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ui.git",
    "directory": "packages/config"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./eslint/next": "./eslint/next.js",
    "./eslint/krizaka-ui": "./eslint/krizaka-ui.js",
    "./eslint/no-locale-ternary": "./eslint/no-locale-ternary.js",
    "./patterns": "./patterns.js",
    "./ratchet": "./ratchet/ratchet.js",
    "./prettier": "./prettier.config.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/react-library.json": "./tsconfig/react-library.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json",
    "./editorconfig": "./.editorconfig",
    "./package.json": "./package.json"
  },
  "bin": {
    "krizaka-ratchet": "./bin/krizaka-ratchet.mjs"
  },
  "files": [
    "bin",
    "eslint",
    "ratchet",
    "tsconfig",
    "patterns.js",
    "prettier.config.js",
    ".editorconfig",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --max-warnings 0 && tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "publint": "publint"
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "tinyglobby": "^0.2.17",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "eslint": "^9",
    "eslint-config-next": ">=16",
    "prettier": "^3",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/file": "^14.2.0",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "next": "^16.4.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "krizaka-ratchet",
      "path": [
        "bin/krizaka-ratchet.mjs",
        "ratchet/ratchet.js",
        "patterns.js"
      ],
      "limit": "5 kB",
      "gzip": true
    }
  ]
}

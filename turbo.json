{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "ORGANIZE_DB_IT",
        "STORAGE_DB_IT",
        "STORAGE_S3_IT"
      ]
    },
    "check": {
      "dependsOn": [
        "^build",
        "^check"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}

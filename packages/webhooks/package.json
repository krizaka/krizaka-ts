{
  "name": "@krizaka/webhooks",
  "version": "0.3.1",
  "description": "Signed and idempotent webhooks, both ways, for every Krizaka product. Out: an owner registers endpoints, events are queued once per endpoint and delivered signed with retries and a delivery log. In: a body is verified (HMAC, timestamp tolerance) and applied exactly once. PostgreSQL adapter and migration; the HTTP call, the secret sealing and the clock are the product's.",
  "keywords": [
    "krizaka",
    "webhooks",
    "hmac",
    "idempotency",
    "outbox"
  ],
  "homepage": "https://github.com/krizaka/krizaka-ts/tree/main/packages/webhooks",
  "bugs": "https://github.com/krizaka/krizaka-ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ts.git",
    "directory": "packages/webhooks"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text-summary \"--coverage.include=src/**/*.ts\"",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@krizaka/db": "workspace:^",
    "@krizaka/payments": "workspace:^",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@krizaka/config": "workspace:^",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.0",
    "pg": "^8.23.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

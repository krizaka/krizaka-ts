{
  "name": "@krizaka/outbox",
  "version": "0.1.3",
  "description": "The transactional outbox of every Krizaka product: an event written in the caller's transaction, delivered after the commit at least once by leased workers, with doubling retries, dead letters and an idempotent-consumer helper. No broker, no database client, no wall clock.",
  "keywords": [
    "krizaka",
    "outbox",
    "events",
    "postgresql",
    "at-least-once"
  ],
  "homepage": "https://github.com/krizaka/krizaka-ts/tree/main/packages/outbox",
  "bugs": "https://github.com/krizaka/krizaka-ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ts.git",
    "directory": "packages/outbox"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./testkit": {
      "types": "./dist/testkit.d.ts",
      "import": "./dist/testkit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text-summary \"--coverage.include=src/**/*.ts\"",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@krizaka/config": "workspace:^",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.0",
    "pg": "^8.23.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@krizaka/db": "workspace:^",
    "@krizaka/settings": "workspace:^",
    "@krizaka/time": "workspace:^"
  },
  "peerDependencies": {
    "vitest": ">=4",
    "zod": ">=3.23"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}

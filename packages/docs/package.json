{
  "name": "@krizaka/docs",
  "version": "0.1.1",
  "description": "The documentation module of every Krizaka product. Its first part is the user manual generated at build from the code: the functional text lives next to the screen it describes (a typed `manual.ts` beside each page), the extractor reads it from the TypeScript program with the routes, the input fields of the schemas, the error and settings catalogues and the e2e journeys, and a screen without its text, a stale route, an undescribed field or an unknown error code fails the build.",
  "keywords": [
    "krizaka",
    "docs",
    "manual",
    "documentation",
    "typescript"
  ],
  "homepage": "https://ts.krizaka.com/docs",
  "bugs": "https://github.com/krizaka/krizaka-ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ts.git",
    "directory": "packages/docs"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text-summary \"--coverage.include=src/**/*.ts\"",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "typescript": ">=5.5"
  },
  "devDependencies": {
    "@krizaka/config": "workspace:^",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}

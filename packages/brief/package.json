{
  "name": "@krizaka/brief",
  "version": "0.1.1",
  "description": "A Krizaka product's weekly brief: a few figured recommendations, each with one action. The contract (integer money, named figures, evidence, assumptions), guards that veto with a reason, a deterministic ranking that keeps the top three, and the week in the shop's time zone. Pure: no framework, no database, no wall clock.",
  "keywords": [
    "krizaka",
    "brief",
    "recommendations",
    "insights",
    "small-business"
  ],
  "homepage": "https://github.com/krizaka/krizaka-ts/tree/main/packages/brief",
  "bugs": "https://github.com/krizaka/krizaka-ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ts.git",
    "directory": "packages/brief"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@krizaka/intl": "^0.4.1",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@krizaka/config": "workspace:^",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

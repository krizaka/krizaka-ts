{
  "name": "@krizaka/architecture",
  "version": "0.1.0",
  "description": "The C4 view of a repository, generated from its code and manifests: containers from the workspaces (with their version and the org dependencies that build them, from the lockfile), Maven modules, crates and Python projects, components from the folders, the imports between them, the external services from the env declarations. Runs on a local checkout or a map of files, writes JSON and a text version.",
  "keywords": [
    "krizaka",
    "c4",
    "architecture",
    "dependencies",
    "versions"
  ],
  "homepage": "https://ts.krizaka.com/architecture",
  "bugs": "https://github.com/krizaka/krizaka-ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ts.git",
    "directory": "packages/architecture"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "bin": {
    "krizaka-architecture": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "node --check src/index.mjs",
    "test": "node --test",
    "check": "pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "smol-toml": "1.9.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@krizaka/config": "workspace:^",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}

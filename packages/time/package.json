{
  "name": "@krizaka/time",
  "version": "0.2.0",
  "description": "Date arithmetic for every Krizaka backend, in one place: add seconds, minutes and hours to an instant, measure the gap between two, compare them. Exact on the instant, whatever the server's time zone. The facade the « Krizaka first » dates rule points to, so no package imports a date library of its own.",
  "keywords": [
    "krizaka",
    "time",
    "date",
    "instant"
  ],
  "homepage": "https://github.com/krizaka/krizaka-ts/tree/main/packages/time",
  "bugs": "https://github.com/krizaka/krizaka-ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ts.git",
    "directory": "packages/time"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text-summary \"--coverage.include=src/**/*.ts\"",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@krizaka/config": "workspace:^",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "date-fns": "^4.4.0"
  }
}
